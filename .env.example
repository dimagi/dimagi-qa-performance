# Copy to .env and fill in. Never commit .env. Every ${VAR} in scenarios/*.yaml reads from here or the shell.

QAPERF_ENV=staging

# --- Web load (scenarios/hq_web_load.yaml) ---
HQ_BASE_URL=https://staging.commcarehq.org
HQ_DOMAIN=qateam
HQ_WEB_USERNAME=
HQ_WEB_PASSWORD=
# Optional CSV (username,password), one row per web user
QAPERF_WEB_USERS=

# --- Mobile load (scenarios/commcare_mobile_load.yaml) ---
HQ_PERF_DOMAIN=
HQ_PERF_APP_ID=
HQ_PERF_APP_VERSION=
# CSV of mobile workers (username,password); >= peak users rows for distinct users
QAPERF_MOBILE_USERS=

# --- Mobile device perf (scenarios/commcare_mobile_perf.yaml) ---
CC_MOBILE_FLOWS=../../commcare-mobile/dimagi-qa-commcare-mobile/flows
APP_CODE_BASIC_TESTS=
# Optional CSV: with several devices, each device logs in as the next row
QAPERF_DEVICE_USERS=

# --- Slack (only used with --slack or reporting.slack: true) ---
SLACK_WEBHOOK_URL=
# or
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
